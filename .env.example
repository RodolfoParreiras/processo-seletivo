# Copie para .env e defina valores fortes. O arquivo .env nunca deve ser versionado.

# Superusuário do PostgreSQL: usado somente pelo container para inicialização.
POSTGRES_DB=processo_seletivo
POSTGRES_SUPERUSER_PASSWORD=

# Dono do schema: usado somente pelo Flyway para executar migrations.
DB_OWNER_USER=ps_owner
DB_OWNER_PASSWORD=

# Usuário da aplicação: apenas SELECT/INSERT/UPDATE/DELETE nas tabelas do schema.
DB_APP_USER=ps_app
DB_APP_PASSWORD=

# Porta HTTP publicada pelo Nginx na máquina local.
HTTP_PORT=8080

# URL pública do sistema, usada nos links enviados por e-mail.
APP_PUBLIC_URL=http://localhost:8080

# SMTP. Valores abaixo apontam para o Mailpit local (perfil "dev" do compose).
# Em produção: SMTP institucional com autenticação e STARTTLS.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=nao-responda@localhost

# Provisionamento único do primeiro Administrador Geral (ver README).
# Habilite, suba a aplicação uma vez e volte para false.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_CPF=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=

# Chave AES-256 em Base64 que cifra os segredos de MFA dos administradores.
# Gere com: openssl rand -base64 32. Não troque depois de em uso: os cadastros de MFA deixariam de funcionar.
MFA_ENCRYPTION_KEY=
